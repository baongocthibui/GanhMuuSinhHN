# Sao chép thành .env khi chạy máy cá nhân. KHÔNG đưa file .env lên GitHub.
# Khi deploy (Render, Railway...) khai báo các biến này trong phần Environment.

# OAuth Client ID (loại Web) tạo ở Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ID của Google Sheet (đoạn giữa /d/ và /edit trong link Sheet)
SHEET_ID=
# Tên tab, hàng 1 là: id ten mat_hang quan dia_chi lat lng gio_ban ghi_chu xac_minh duyet nguoi_gui thoi_gian image
SHEET_TAB=reports

# Chuỗi ngẫu nhiên dài, ví dụ tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# File JSON của service account, mã hoá base64 thành một dòng:
# Linux/macOS: base64 -w0 key.json
# Windows / Mọi HĐH: node -e "console.log(require('fs').readFileSync('key.json').toString('base64'))"
SA_JSON_B64=

# Email liên hệ gửi kèm khi gọi Nominatim (theo quy định sử dụng của OpenStreetMap)
CONTACT_EMAIL=
